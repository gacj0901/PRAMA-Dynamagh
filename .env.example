# Use the existing shared services only through the external Docker network.
EXTERNAL_SERVICES_NETWORK=firecrawl_backend
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
REDIS_URL=redis://redis:6379/3

# PRAMA-Dynamagh owns this database only.
POSTGRES_DB=prama_dynamagh
POSTGRES_USER=prama
POSTGRES_PASSWORD=replace-this-local-dev-password
DATABASE_URL=postgresql+psycopg://prama:replace-this-local-dev-password@postgres:5432/prama_dynamagh

API_PORT=8000
GATEWAY_PORT=8081
WEB_PORT=5173
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com
GATEWAY_URL=http://gateway:8081

# Gateway-only secret. Do not add this to API, worker, or frontend environments.
TELEGRAPH_SIGNER_PRIVATE_KEY=
MAX_PAYMENT_USDC=5.00
