# Use the existing shared services only through the external Docker network.
EXTERNAL_SERVICES_NETWORK=firecrawl_backend
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
REDIS_URL=redis://redis:6379/3

# PRAMA-Dynamagh owns this database only.
POSTGRES_DB=prama_dynamagh
POSTGRES_USER=prama
POSTGRES_PASSWORD=replace-this-local-dev-password
DATABASE_URL=postgresql+psycopg://prama:replace-this-local-dev-password@postgres:5432/prama_dynamagh

API_PORT=8000
GATEWAY_PORT=8081
WEB_PORT=5173
TELEGRAPH_BASE_URL=https://devnode.telegraphprotocol.com
GATEWAY_URL=http://gateway:8081

# Dedicated external M2M Bearer secret. Never reuse an internal or signer secret.
PRAMA_M2M_API_TOKEN=

# Gateway-only secret. Do not add this to API, worker, or frontend environments.
TELEGRAPH_SIGNER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PRAMA_TICKET_ANCHOR_ADDRESS=0x3c1a6acfd3b7ff981c31797533169e5ee36dd6e9
PRAMA_GATEWAY_INTERNAL_TOKEN=
TELEGRAPH_MAX_PAYMENT_USDC=0.010000
ERC8183_MAX_JOB_BUDGET_USDC=2.000000
# Explicitly opt in only after G7 read-only preflight has passed.
ERC8183_LIVE_WRITES_ENABLED=false
TELEGRAPH_CALLBACK_CONTRACT_ADDRESS=
AUTONOMY_GLOBAL_ENABLED=false
# One shared cap across manual/public UI, M2M, and internal autonomy.
PUBLIC_MAX_MANDATE_USDC=0.500000
M2M_MAX_WORKFLOW_USDC=0.500000
PUBLIC_DAILY_SPEND_CAP_USDC=20.00
GLOBAL_DAILY_SPEND_CAP_USDC=20.00
