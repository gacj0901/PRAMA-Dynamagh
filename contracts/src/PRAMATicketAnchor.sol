pragma solidity ^0.8.34;
contract PRAMATicketAnchor { error Unauthorized(); error ZeroTicketHash(); error AlreadyAnchored(bytes32); error ZeroOperator(); address public immutable operator; mapping(bytes32=>uint256) public anchoredAtBlock; event TicketAnchored(bytes32 indexed ticketHash,address indexed operator,uint256 blockNumber); constructor(address initialOperator){if(initialOperator==address(0))revert ZeroOperator();operator=initialOperator;} function anchor(bytes32 ticketHash) external {if(msg.sender!=operator)revert Unauthorized();if(ticketHash==bytes32(0))revert ZeroTicketHash();if(anchoredAtBlock[ticketHash]!=0)revert AlreadyAnchored(ticketHash);anchoredAtBlock[ticketHash]=block.number;emit TicketAnchored(ticketHash,msg.sender,block.number);} function isAnchored(bytes32 ticketHash) external view returns(bool){return anchoredAtBlock[ticketHash]!=0;}}
